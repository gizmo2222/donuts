<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/cream"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_level"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="@color/brown_dark"
        android:layout_marginBottom="48dp" />

    <!-- Level 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="20dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/level_1_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/brown_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/level_1_desc"
            android:textSize="16sp"
            android:textColor="@color/brown_medium"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnLevel1"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/play_level"
            android:backgroundTint="@color/matcha"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Level 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="20dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/level_2_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/brown_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/level_2_desc"
            android:textSize="16sp"
            android:textColor="@color/brown_medium"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnLevel2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/play_level"
            android:backgroundTint="@color/caramel"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Level 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/level_3_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/brown_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/level_3_desc"
            android:textSize="16sp"
            android:textColor="@color/brown_medium"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnLevel3"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/play_level"
            android:backgroundTint="@color/chocolate"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
