<?xml version="1.0" encoding="utf-8"?>
<!-- "Donuts for Steven" launcher icon: a soccer ball (the same ball as the home screen) peeking
     through a donut. The group shrinks the art and moves it down so the whole donut sits inside
     the adaptive-icon safe zone (a radius-33 circle centred at 54,54) under every mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <group android:pivotX="54" android:pivotY="48"
         android:scaleX="0.92" android:scaleY="0.92"
         android:translateY="6">

    <!-- === Soccer ball (behind the donut, seen through the hole) === -->
    <path android:fillColor="#1C0C00"
          android:pathData="M54,28 A20,20 0 1 1 54,68 A20,20 0 1 1 54,28 Z"/>
    <path android:fillColor="#FFFFFF"
          android:pathData="M54,29.5 A18.5,18.5 0 1 1 54,66.5 A18.5,18.5 0 1 1 54,29.5 Z"/>
    <!-- Centre patch -->
    <path android:fillColor="#1C0C00"
          android:pathData="M54,43.8 L57.99,46.7 L56.47,51.4 L51.53,51.4 L50.01,46.7 Z"/>
    <!-- Seams out to the outer patches -->
    <path android:strokeColor="#1C0C00" android:strokeWidth="1.3" android:strokeLineCap="round"
          android:pathData="M54,43.8 L54,40.4 M57.99,46.7 L61.23,45.65 M56.47,51.4 L58.47,54.15
                            M51.53,51.4 L49.53,54.15 M50.01,46.7 L46.77,45.65"/>
    <!-- Outer patches (their tips show at the edge of the hole) -->
    <path android:fillColor="#1C0C00"
          android:pathData="M54,40.4 L50.58,37.91 L51.88,33.89 L56.12,33.89 L57.42,37.91 Z
                            M61.23,45.65 L62.54,41.63 L66.77,41.63 L68.08,45.65 L64.65,48.14 Z
                            M58.47,54.15 L62.7,54.15 L64.01,58.17 L60.58,60.66 L57.16,58.17 Z
                            M49.53,54.15 L50.84,58.17 L47.42,60.66 L43.99,58.17 L45.3,54.15 Z
                            M46.77,45.65 L43.35,48.14 L39.92,45.65 L41.23,41.63 L45.46,41.63 Z"/>

    <!-- === Donut (in front of the ball) === -->
    <!-- Donut dark outline annulus -->
    <path android:fillColor="#1C0C00"
          android:pathData="M54,14 A34,34 0 1 1 54,82 A34,34 0 1 1 54,14 Z
                            M54,36 A12,12 0 1 0 54,60 A12,12 0 1 0 54,36 Z"/>
    <!-- Donut body (pink) -->
    <path android:fillColor="#FF5578"
          android:pathData="M54,16 A32,32 0 1 1 54,80 A32,32 0 1 1 54,16 Z
                            M54,37 A11,11 0 1 0 54,59 A11,11 0 1 0 54,37 Z"/>
    <!-- Donut glaze (hot pink) -->
    <path android:fillColor="#E60032"
          android:pathData="M54,20 A28,28 0 1 1 54,76 A28,28 0 1 1 54,20 Z
                            M54,39 A9,9 0 1 0 54,57 A9,9 0 1 0 54,39 Z"/>
    <!-- Sprinkles (white dots) -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M38,34 A2.5,2.5 0 1,0 43,34 A2.5,2.5 0 1,0 38,34 Z
                            M65,34 A2.5,2.5 0 1,0 70,34 A2.5,2.5 0 1,0 65,34 Z
                            M51,26 A2.5,2.5 0 1,0 56,26 A2.5,2.5 0 1,0 51,26 Z
                            M32,48 A2.5,2.5 0 1,0 37,48 A2.5,2.5 0 1,0 32,48 Z
                            M71,48 A2.5,2.5 0 1,0 76,48 A2.5,2.5 0 1,0 71,48 Z"/>
