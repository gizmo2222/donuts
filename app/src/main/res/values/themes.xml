<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The platform theme: both screens draw everything themselves, so no appcompat or Material.
         The cream window background is what shows before the first frame and behind the splash. -->
    <style name="Base.Theme.Donuts" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Donuts" parent="Base.Theme.Donuts" />
</resources>
